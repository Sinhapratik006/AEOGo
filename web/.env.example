# Copy this file to .env.local and fill in the values.
# Both the Next.js app and the worker read these variables.

# ─── App ────────────────────────────────────────────────────────────────
# Public URL of the site, without a trailing slash. Used for checkout return
# URLs, emails and secure cookies (https:// enables the Secure cookie flag).
APP_URL=http://localhost:3000

# PostgreSQL connection string. The database must use UTF-8 encoding
# (the default on Neon, Supabase, Railway, Render and the docker-compose file).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aeogo

# ─── Dodo Payments ──────────────────────────────────────────────────────
# Dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=
# Dashboard → Developer → Webhooks → your endpoint → Signing secret (starts with whsec_)
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode. Anything other than live_mode uses test mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Product IDs (pdt_...) of three monthly subscription products you create in
# Dashboard → Products. Set the subscription period longer than the billing
# frequency (e.g. 10 years, billed monthly) so plans renew every month.
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_GROWTH=
DODO_PRODUCT_ID_PRO=

# ─── AI fixes (optional) ────────────────────────────────────────────────
# Without a key, audits still run; AI-written title/description fixes are skipped.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Email (optional) ───────────────────────────────────────────────────
# Without these, emails (password resets, reports) are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="AEOGo <hello@yourdomain.com>"

# ─── Security (optional) ────────────────────────────────────────────────
# Header your hosting proxy sets with the real client IP, used for rate limiting
# (e.g. cf-connecting-ip behind Cloudflare, fly-client-ip on Fly.io). Leave empty
# to use x-real-ip / x-forwarded-for.
TRUSTED_IP_HEADER=

# ─── Worker tuning (optional) ───────────────────────────────────────────
WORKER_CONCURRENCY=2
CRAWL_DELAY_MS=500
CRAWL_TIME_BUDGET_MINUTES=45
DATABASE_POOL_MAX=10
